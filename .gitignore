# Ignore Docker volume bind mounts (if you ever map them locally)
postgres_data/
n8n_data/

# =========================
# Media & Uploads
# =========================
# Ignore user-submitted audio files to prevent repo bloat
data/uploads/*
!data/uploads/.gitkeep

# Ignore loose audio files anywhere
*.wav
*.mp3
*.m4a
*.webm
*.ogg

